{
  "name": "@aigit/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "aigit": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --dts --clean --format esm",
    "dev": "tsup src/index.ts --dts --watch --format esm",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aigit/core": "workspace:*",
    "commander": "^13.1.0",
    "@clack/prompts": "^0.10.0",
    "picocolors": "^1.1.0"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "vitest": "^3.1.0",
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0"
  }
}